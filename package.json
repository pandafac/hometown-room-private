{
  "name": "hometown-room",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "start": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "validate:data": "node scripts/validate-data.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "node scripts/e2e-test.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "html-to-image": "^1.11.13",
    "sharp": "^0.35.5",
    "vite": "^8.3.6"
  }
}
